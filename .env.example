NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/precedentiq

# JWT Authentication
JWT_SECRET=precedentiq_super_secure_jwt_enterprise_secret_key_2026_change_in_prod
JWT_EXPIRES_IN=1d

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
