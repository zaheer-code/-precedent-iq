# ==============================================================================
# PRECEDENTIQ ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: DO NOT commit your actual .env file or real secrets to version control.
# Copy this file to .env and replace placeholders with your actual values.

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (Used ONLY by Express Backend)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# PostgreSQL Database with pgvector (Supabase, Neon, or local PostgreSQL)
# Example for Supabase Pooler: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/precedentiq

# JWT Authentication Secret (Use a strong, random 64-character string in production)
JWT_SECRET=replace_with_a_secure_jwt_enterprise_secret_key_minimum_32_chars
JWT_EXPIRES_IN=1d

# Google Gemini API Key (Backend AI intelligence & embeddings via text-embedding-004)
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Document Ingestion Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Allowed Client Origin(s) for CORS (comma-separated list for multiple domains)
# Local: http://localhost:5173
# Production: https://your-precedentiq-client.vercel.app
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Used ONLY by Vite React Frontend on Vercel)
# ------------------------------------------------------------------------------
# In local development: Leave blank or omitted to use the built-in Vite dev proxy (/api -> http://localhost:5000)
# In production on Vercel: Set to your deployed backend API URL (e.g. https://precedentiq-api.onrender.com)
VITE_API_URL=
