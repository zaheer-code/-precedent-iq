# ==============================================================================
# PrecedentIQ Express Backend Server Configuration
# ==============================================================================

NODE_ENV=production
PORT=5000

# Supabase PostgreSQL Connection String (must include pgvector)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT Secret Key for token signing (never share with frontend)
JWT_SECRET=replace_with_a_secure_jwt_enterprise_secret_key_minimum_32_chars
JWT_EXPIRES_IN=1d

# Google Gemini API Key (for server-side RAG & embeddings)
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Temporary File Storage for Ingestion Parsing
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# Allowed Client Origin (Vercel Frontend URL) for CORS
CLIENT_URL=https://your-precedentiq-client.vercel.app
